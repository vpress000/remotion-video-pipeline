# =====================================================================
# LLM provider configuration
# Copy this file to ".env" and fill in a key to enable the planning layer.
# The RENDERER works without any key (it uses data/specs/sample.video-spec.json).
# =====================================================================

# Which provider the agents call: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# =====================================================================
# Asset locations (optional). Defaults live in config/pipeline.config.ts.
# Point these at your real Bee Naturals working folders to use live assets.
# =====================================================================
# BN_CAPTIONS_DIR=C:\Users\patel\Downloads\BeeNaturals\Video Work\Subtitles\VTT Files
# BN_FOOTAGE_DIR=C:\Users\patel\Downloads\BeeNaturals\Video Work\Videos to Cut
# BN_AUDIO_DIR=assets/audio
